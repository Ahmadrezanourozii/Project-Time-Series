\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Subject-level confusion matrices of the final Mamba model (100 subjects, pooled over the five disjoint test folds), for the left foot, the right foot and both feet. Rows are true classes, columns predicted classes; HC = healthy control, PD = Parkinson's disease.}}{4}{figure.3}\protected@file@percent }
\newlabel{fig:confusion}{{3}{4}{Subject-level confusion matrices of the final Mamba model (100 subjects, pooled over the five disjoint test folds), for the left foot, the right foot and both feet. Rows are true classes, columns predicted classes; HC = healthy control, PD = Parkinson's disease}{figure.3}{}}
