\citation{gu2023mamba}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces End-to-end pipeline. Raw VGRF recordings (16 sensors plus two per-foot totals, 100\,Hz) are trimmed, windowed and converted into token sequences -- one token per second, holding 11 statistics for each of the 18 channels; the Mamba encoder produces a window score, and the scores of a subject's windows are averaged into one decision. Normalisation statistics and every hyper-parameter are estimated on training and validation data only, and each of the five subject-wise folds contributes a disjoint set of test subjects.}}{2}{figure.1}\protected@file@percent }
\newlabel{fig:pipeline}{{1}{2}{End-to-end pipeline. Raw VGRF recordings (16 sensors plus two per-foot totals, 100\,Hz) are trimmed, windowed and converted into token sequences -- one token per second, holding 11 statistics for each of the 18 channels; the Mamba encoder produces a window score, and the scores of a subject's windows are averaged into one decision. Normalisation statistics and every hyper-parameter are estimated on training and validation data only, and each of the five subject-wise folds contributes a disjoint set of test subjects}{figure.1}{}}
