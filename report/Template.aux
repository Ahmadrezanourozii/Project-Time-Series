\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Subject-level confusion matrices of the final Mamba model over the 100 subjects, pooled from the five disjoint test folds. Rows are true classes and columns predicted classes; HC denotes healthy control and PD Parkinson's disease.}}{4}{figure.3}\protected@file@percent }
\newlabel{fig:confusion}{{3}{4}{Subject-level confusion matrices of the final Mamba model over the 100 subjects, pooled from the five disjoint test folds. Rows are true classes and columns predicted classes; HC denotes healthy control and PD Parkinson's disease}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces The two evaluation protocols. Each row is a subject and each cell one window. (a) Subject-wise: whole subjects are held out, so nothing about a test subject appears in training. (b) Window-wise: test windows are drawn at random, so almost every test window has a near-duplicate neighbour from the same recording in the training set.}}{4}{figure.4}\protected@file@percent }
\newlabel{fig:protocols}{{4}{4}{The two evaluation protocols. Each row is a subject and each cell one window. (a) Subject-wise: whole subjects are held out, so nothing about a test subject appears in training. (b) Window-wise: test windows are drawn at random, so almost every test window has a near-duplicate neighbour from the same recording in the training set}{figure.4}{}}
